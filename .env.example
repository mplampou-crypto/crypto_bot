# ── Bybit API keys ──────────────────────────────────────────────
# Create at: Bybit → API → Create New Key
# Permissions: ENABLE "Contract - Orders & Positions" (Trade) ONLY.
# DO NOT enable Withdrawal. Whitelist your VPS IP.
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# false = real money (live).  true = Bybit testnet (fake money).
BYBIT_TESTNET=false

# ── Webhook security ────────────────────────────────────────────
# A long random string. The SAME value must be in every TradingView
# alert JSON. Without a match the bot ignores the alert.
# Generate one e.g.:  python -c "import secrets;print(secrets.token_hex(24))"
WEBHOOK_SECRET=change_this_to_a_long_random_string

# ── Dashboard ───────────────────────────────────────────────────
# Optional. If set, the dashboard requires ?token=... to open.
# Leave empty to disable (then firewall the port / use a reverse proxy).
DASHBOARD_TOKEN=

# Port the server listens on
PORT=8000
