# ── Bybit API (Trade permission only, NO withdrawal, IP-whitelist your host) ──
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
# false = real money (LIVE).  true = Bybit testnet (fake money).
BYBIT_TESTNET=false

# ── Webhook security (must match the "secret" field in every alert) ──
# generate:  python -c "import secrets; print(secrets.token_hex(24))"
WEBHOOK_SECRET=change_this_to_a_long_random_string

# ── Telegram (optional but recommended) ──
# 1) talk to @BotFather -> /newbot -> get the token
# 2) message your new bot, send /start -> it replies with your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Server ──
PORT=8080

# Taker fee per side used for PnL/win-rate (Bybit linear ~0.055%)
TAKER_FEE=0.00055
